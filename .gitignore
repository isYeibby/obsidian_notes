# =======================================================
# Obsidian: Estados de ventana, UI local y cachés
# =======================================================
# Cambian constantemente según la pantalla y pestañas abiertas (causa principal de conflictos)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Cachés locales e indexación interna
.obsidian/cache/
.obsidian/.cache/

# =======================================================
# Archivos del sistema operativo y respaldos temporales
# =======================================================
.trash/
.DS_Store
Thumbs.db
*~
*.tmp
*.swp

# =======================================================
# (Opcional) Archivos multimedia pesados
# Descomenta si manejas grabaciones o videos grandes y no usas Git LFS
# =======================================================
